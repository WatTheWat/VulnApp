         <li>\n          <strong>Priya</strong>\n          <span>Large Null Byte Latte</span>\n        </li>\n          </ul>\n  </div>\n  <div class=\"about\">\n    <h2>About us</h2>\n    <p>Neil and Avi started roasting packets in a dorm room with one rule: every cup is\n       brewed to order and delivered over HTTP. Nothing to spill, nothing to pay, and\n       the line is never longer than your bandwidth.</p>\n  </div>\n</section>\n</main>\n<footer class=\"site-footer\">\n  <p>Neil and Avi's Coffee Shop · Est. 2026 · Serving virtual coffee to real hackers</p>\n  <p class=\"fine\">All drinks are imaginary. No beans were harmed. <a href=\"/admin/login.php\">Staff</a></p>\n</footer>\n</body>\n</html>\n","http_code":200,"headers":{"Server":"nginx","Server":"nginx","Date":"Mon, 19 Oct 2026 21:46:14 GMT","Content-Type":"text/html; charset=UTF-8","Connection":"keep-alive","Cache-Control":"no-store, no-cache, must-revalidate","Pragma":"no-cache","X-Powered-By":"PHP/8.3.35","Set-Cookie":"PHPSESSID=0ab9c470ffc349580f7a0326348ed637; path=/; HttpOnly","Expires":"Thu, 19 Nov 1981 08:52:00 GMT","Access-Control-Allow-Headers":"*"}},"producer":{"modsecurity":"ModSecurity v3.0.17 (Linux)","connector":"ModSecurity-nginx v1.0.4","secrules_engine":"DetectionOnly","components":["OWASP_CRS/4.30.0\""]},"messages":[{"message":"Host header is a numeric IP address","details":{"match":"Matched \"Operator `Rx' with parameter `(?:^([\\d.]+|\\[[\\da-f:]+\\]|[\\da-f:]+)(:[\\d]+)?$)' against variable `REQUEST_HEADERS:Host' (Value: `20.42.115.173' )","reference":"o0,13o0,13v216,13","ruleId":"920350","file":"/etc/modsecurity.d/owasp-crs/rules/REQUEST-920-PROTOCOL-ENFORCEMENT.conf","lineNumber":"756","data":"20.42.115.173","severity":"4","ver":"OWASP_CRS/4.30.0","rev":"","tags":["modsecurity","application-multi","language-multi","platform-multi","attack-protocol","paranoia-level/1","OWASP_CRS","OWASP_CRS/PROTOCOL-ENFORCEMENT","capec/1000/210/272"],"maturity":"0","accuracy":"0"}}]}}
